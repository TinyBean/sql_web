{
  "name": "sqlite-database-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A SQLite database Q&A website powered by pi-coding-agent",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "tsx scripts/clean.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build": "npm run clean && npm run build:server && npm run build:client",
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "tsc -p tsconfig.client.json --watch --preserveWatchOutput",
    "data": "tsx scripts/oee-data.ts",
    "data:import": "tsx scripts/oee-data.ts import",
    "data:pull": "tsx scripts/oee-data.ts pull",
    "data:sync": "tsx scripts/oee-data.ts sync",
    "data:status": "tsx scripts/oee-data.ts status",
    "start": "npm run build && node --enable-source-maps dist/src/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
