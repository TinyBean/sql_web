{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "public/generated",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "sourceMap": false
  },
  "include": ["src/client/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["dist", "node_modules", "public/generated"]
}
