HOST=127.0.0.1
PORT=3000

# Required. The selected model must exist in .data/agent/models-store.json
# or be configured by .data/agent/models.json.
SQL_WEB_PROVIDER=zai
SQL_WEB_MODEL=glm-5.3-flash

# Optional storage overrides. Relative paths are resolved from the project root.
# SQL_WEB_DB_PATH=.data/oee.sqlite
# SQL_WEB_SESSION_DIR=.data/sessions

# Optional OEE API root used by npm run data:pull / data:sync.
# OEE_API_BASE_URL=http://csj-mp-dvapp03.wdc.com:9400/json/Interface/ORPTSIP/
